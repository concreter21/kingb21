# --- MongoDB ---
# Get a free 512MB cluster at https://www.mongodb.com/cloud/atlas/register
# Connection string looks like: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGO_URL=your_mongodb_connection_string_here
DB_NAME=solarsafe

# --- Gemini (replaces Emergent's LLM proxy) ---
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override default models (both default to gemini-2.5-flash)
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Admin 2FA demo code (change this!) ---
ADMIN_2FA_CODE=123456
